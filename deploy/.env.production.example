# Copy to backend/.env on the EC2 box and fill in real values.
# NEVER commit the real .env — this is a template only.

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/vero
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
GEMINI_API_KEY=REPLACE_WITH_REAL_KEY
PORT=8080

# If you point the backend at your self-hosted Ollama box instead of/alongside Gemini:
# OLLAMA_BASE_URL=http://<llm-instance-private-ip>:11434
